Subject: [PATCH 1/2] Update MouseWheelEvent kWheelDelta build flags

Removed Linux build flag from MouseWheelEvent.
---
 ui/events/event.cc | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/ui/events/event.cc b/ui/events/event.cc
index 280ed1b75c02d5..99cc56341c0c48 100644
--- a/ui/events/event.cc
+++ b/ui/events/event.cc
@@ -631,7 +631,7 @@ std::unique_ptr<Event> MouseWheelEvent::Clone() const {
   return std::make_unique<MouseWheelEvent>(*this);
 }
 
-#if BUILDFLAG(IS_WIN) || BUILDFLAG(IS_FUCHSIA) || BUILDFLAG(IS_LINUX)
+#if BUILDFLAG(IS_WIN) || BUILDFLAG(IS_FUCHSIA)
 // This value matches Windows, Fuchsia WHEEL_DELTA, and (roughly) Firefox on
 // Linux.
 // static

From 5fcb26898b87734f477cff9fb94775c66f6ae64c Mon Sep 17 00:00:00 2001
From: Moon <64157802+signalno11@users.noreply.github.com>
Date: Sun, 9 Nov 2025 20:59:52 -0600
Subject: [PATCH 2/2] Change wheel scroll amount from 120 to 53

---
 ui/events/x/events_x_utils.cc | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/ui/events/x/events_x_utils.cc b/ui/events/x/events_x_utils.cc
index c9cce0092930e5..019d5ee38a0b99 100644
--- a/ui/events/x/events_x_utils.cc
+++ b/ui/events/x/events_x_utils.cc
@@ -36,7 +36,7 @@ namespace {
