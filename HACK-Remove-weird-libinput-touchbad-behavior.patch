@@ -402,7 +402,10 @@ function pixelsPerTick() {
     return 64;
 
   // Legacy, comes from ui/events/event.cc
-  return 53;
+  if (navigator.platform.indexOf("Linux") != -1)
+  {
+    return 53;
+  }
 }
 
